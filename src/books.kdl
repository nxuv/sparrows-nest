!doctype "html"
html {
    head {
        @include "_lib/meta.kdl"

        title "Data Sparrow - Books"

        script src="/js/easydom.js"
        script src="/js/cookie.js"
        script src="/js/themeloader.js"

        link rel="stylesheet" type="text/css" href="/css/index.css"
        link rel="stylesheet" type="text/css" href="/css/games.css"

        link rel="stylesheet" type="text/css" href="/css/navbar.css"

        script src="/js/games.js"

        // style " * { outline: 1px solid green !important; } "
    }

    body {
        @include "_lib/navbar.kdl"

        div id="content" {
            div id="carousel" {
                button id="button-left" class="c-button img-bw"
                button id="button-right" class="c-button img-bw"
            }

            div id="descbox" {
                // - ------------------------------ PSYCHO PATROL ------------------------------- -
                div class="gamedesc" {
                    img class="gameimg" src="/img/books/psycho-patrol.png"

                    p class="gamelink" { a href="https://datasparrow.itch.io/orientation-an-introductory-zinelet-to-psycho-patrol-r" "Get Now!" }

                    strong {
                        p "ORIENTATION"
                        p "AN INTRODUCTORY ZINLET TO PSYCHO PATROL R"
                        p "Release Date: March 23th 2025"
                        p "Platform: Itch.io"
                    }

                    @include "_lib/separator.kdl"
                    @include "_md/info-book-ppr.md"
                }
                // - ------------------------------ Panthalassa ------------------------------- -
                div class="gamedesc" {
                    img class="gameimg" src="/img/books/panthalassa.png"

                    p class="gamelink" { a href="https://datasparrow.itch.io/all-sea-a-panthalassa-zinelet" "Get Now!" }

                    strong {
                        p "ALL SEA"
                        p "AN INTRODUCTORY ZINLET TO PANTHALASSA"
                        p "Release Date: May 18th 2026"
                        p "Platform: Itch.io"
                    }

                    @include "_lib/separator.kdl"
                    @include "_md/info-book-panthalassa.md"
                }
                // ------------------------------ Penguin Colony -------------------------------
                div class="gamedesc" {
                    img class="gameimg" src="/img/books/Field_Notes_Logo.png"

                    p class="gamelink" { a href="https://datasparrow.itch.io/penguin-colony-the-field-notes" "Get Now!" }

                    strong {
                        p "PENGUIN COLONY"
                        p "THE FIELD NOTES"
                        p "Release Date: Oct 17th 2026"
                        p "Platform: Itch.io"
                    }

                    @include "_lib/separator.kdl"
                    @include "_md/info-book-penguin.md"
                }
            }
        }

        @include "_lib/footer.kdl"

        @include "_lib/noscript.kdl"
    }
}
